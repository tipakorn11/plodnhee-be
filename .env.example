# Required in production: use a long, random secret (at least 32 characters).
# Example generator: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# Supabase Postgres connection. Replace [YOUR-PASSWORD] with a percent-encoded
# database password. Keep this server-only; never expose it to the frontend.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.filqcsliygjuhsleurrn.supabase.co:5432/postgres

# Comma-separated frontend origins allowed to call the API.
# Use your deployed Vercel frontend URL; do not include a trailing slash.
CORS_ORIGIN=http://localhost:3000,https://your-app.vercel.app

# Vercel supplies PORT automatically. Set it only for local development if needed.
PORT=3000
