generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  people       Person[]
  groups       Group[]

  @@map("users")
}

model Person {
  id              String   @id @default(uuid())
  ownerId         String   @map("owner_id")
  name            String
  profileImageUrl String?  @map("profile_image_url")
  createdAt       DateTime @default(now()) @map("created_at")
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bills           Bill[]
  groupMemberships GroupMember[]
  discounts       MemberDiscount[]

  @@index([ownerId])
  @@map("people")
}

model Group {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  name      String
  totalOwed Decimal  @default(0) @db.Decimal(12, 2) @map("total_owed")
  createdAt DateTime @default(now()) @map("created_at")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bills     Bill[]
  members   GroupMember[]
  charges   GroupCharge[]
  discounts MemberDiscount[]

  @@index([ownerId])
  @@map("groups")
}

enum PaymentStatus {
  PENDING
  PAID
}

model GroupMember {
  id            String        @id @default(uuid())
  groupId       String        @map("group_id")
  personId      String        @map("person_id")
  balance       Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PAID) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  group         Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person        Person        @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([groupId, personId])
  @@index([personId])
  @@index([groupId, createdAt])
  @@map("group_members")
}

model GroupCharge {
  id              String   @id @default(uuid())
  groupId         String   @map("group_id")
  amountPerPerson Decimal  @db.Decimal(12, 2) @map("amount_per_person")
  description     String?
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([groupId, createdAt])
  @@map("group_charges")
}

model MemberDiscount {
  id          String   @id @default(uuid())
  groupId     String   @map("group_id")
  personId    String   @map("person_id")
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person      Person   @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([groupId, createdAt])
  @@index([personId])
  @@map("member_discounts")
}

model Bill {
  id          String   @id @default(uuid())
  groupId     String?  @map("group_id")
  personId    String   @map("person_id")
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person      Person   @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([groupId, createdAt])
  @@index([personId])
  @@map("bills")
}
